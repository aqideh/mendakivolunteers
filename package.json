{
  "name": "mendakivolunteers",
  "version": "0.1.0",
  "private": true,
  "description": "Volunteer-facing web application for MENDAKI, backed by Supabase and downstream YM Hub data.",
  "engines": {
    "node": "24.x",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check:production": "node scripts/check-production-readiness.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "cheerio": "1.2.0",
    "next": "16.3.4",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
