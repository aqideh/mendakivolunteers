# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Application environment. Production deployments must set this explicitly.
APP_ENV=development
AUTH_ALLOW_SIGN_UP=true

# Transitional only: comma-separated DNS hostnames accepted for external registration links while first-class KELUARGA registration is being implemented.
YMHUB_REGISTRATION_ALLOWED_HOSTS=example.invalid


# Server-only OneMap credentials used to verify volunteer postal codes and derive location data.
# Register an API account at OneMap. Never expose these as NEXT_PUBLIC_* variables.
ONEMAP_API_EMAIL=replace-with-onemap-account-email
ONEMAP_API_PASSWORD=replace-with-onemap-account-password
ONEMAP_BASE_URL=https://www.onemap.gov.sg
